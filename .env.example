PROJECT_NAME=Personalized Learning System
ENVIRONMENT=development

POSTGRES_DB=personalized_learning
POSTGRES_USER=learning_user
POSTGRES_PASSWORD=replace_me
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://learning_user:replace_me@postgres:5432/personalized_learning
ALEMBIC_DATABASE_URL=postgresql+psycopg://learning_user:replace_me@postgres:5432/personalized_learning
DATABASE_ECHO=false

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

BACKEND_PORT=8000
FRONTEND_PORT=5173

CORS_ORIGINS=http://localhost:5173

JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenAI-compatible chat-completions endpoint used to understand learner input.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=45

UPLOADS_DIR=uploads
DOCUMENT_MAX_UPLOAD_BYTES=157286400
DOCUMENT_UPLOAD_CHUNK_BYTES=1048576
DOCUMENT_ANALYSIS_INPUT_CHARS=120000
DOCUMENT_ANALYSIS_OUTPUT_CHARS=200000
DOCUMENT_OCR_ENABLED=true
DOCUMENT_OCR_LANGUAGES=vie+eng
DOCUMENT_OCR_DPI=200
DOCUMENT_OCR_MAX_PAGES=400
DOCUMENT_OCR_MIN_TEXT_CHARS=40
DOCUMENT_OCR_MIN_CONFIDENCE=35
