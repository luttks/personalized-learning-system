PROJECT_NAME=Personalized Learning System
ENVIRONMENT=development

POSTGRES_DB=personalized_learning
POSTGRES_USER=learning_user
POSTGRES_PASSWORD=replace_me
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://learning_user:replace_me@postgres:5432/personalized_learning
ALEMBIC_DATABASE_URL=postgresql+psycopg://learning_user:replace_me@postgres:5432/personalized_learning
DATABASE_ECHO=false

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

BACKEND_PORT=8000
FRONTEND_PORT=5173

CORS_ORIGINS=http://localhost:5173

JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenAI-compatible chat-completions endpoint used to understand learner input.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
LLM_API_KEY2=
LLM_API_KEY3=
LLM_TIMEOUT_SECONDS=45

# Gemini — OCR tài liệu, sinh nội dung (xoay vòng nhiều key khi có), và embedding cho RAG
GEMINI_API_KEY=
GEMINI_API_KEY2=
GEMINI_API_KEY3=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
YOUTUBE_API_KEY=
GITHUB_TOKEN=

# SMTP gửi email OTP xác thực đăng ký — để trống SMTP_HOST nếu chưa có, hệ thống sẽ chỉ log mã
# OTP ra console thay vì gửi email thật (tiện dev/test local).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Personalized Learning System
SMTP_USE_TLS=true
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Kiểm tra năng lực cuối giai đoạn — chặn/mở khóa giai đoạn tiếp theo của lộ trình
PHASE_ASSESSMENT_PASS_THRESHOLD=0.7
PHASE_ASSESSMENT_NUM_QUESTIONS=10
PHASE_ASSESSMENT_SUBMIT_RATE_LIMIT_MAX=5
PHASE_ASSESSMENT_SUBMIT_RATE_LIMIT_WINDOW_SECONDS=600

# Bài thi chốt hạ cuối lộ trình — báo cáo, không phải cửa chặn nên không có ngưỡng đậu
FINAL_EXAM_NUM_QUESTIONS=20
FINAL_EXAM_SUBMIT_RATE_LIMIT_MAX=3
FINAL_EXAM_SUBMIT_RATE_LIMIT_WINDOW_SECONDS=600

# Giờ gửi email nhắc học hằng ngày (theo timezone Asia/Ho_Chi_Minh của Celery Beat)
DAILY_REMINDER_EMAIL_HOUR=7
DAILY_REMINDER_EMAIL_MINUTE=0

# Buổi nhắc thứ 2 trong ngày, riêng cho người học đang bị khóa 1 giai đoạn để học lại
STUCK_REMINDER_EMAIL_HOUR=19
STUCK_REMINDER_EMAIL_MINUTE=0

UPLOADS_DIR=uploads
